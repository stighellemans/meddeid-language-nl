{
  "name": "@meddeid/language-nl",
  "version": "0.1.0",
  "description": "Dutch and nl-BE language-profile capabilities for MedDeID",
  "license": "AGPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/stighellemans/meddeid-language-nl.git"
  },
  "homepage": "https://stighellemans.github.io/meddeid.github.io/concepts/architecture/",
  "bugs": {
    "url": "https://github.com/stighellemans/meddeid-language-nl/issues"
  },
  "keywords": [
    "de-identification",
    "clinical-nlp",
    "dutch",
    "belgium",
    "meddeid"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "exports": {
    "./subannotation": "./js/subannotation-profile.js"
  },
  "meddeid": {
    "subannotationProfiles": [
      {
        "selection": "nl-BE@1",
        "module": "@meddeid/language-nl/subannotation"
      }
    ]
  },
  "files": [
    "js/",
    "src/meddeid_language_nl/resources/lookup/",
    "src/meddeid_language_nl/resources/subannotation/",
    "LICENSE",
    "NOTICE",
    "README.md"
  ],
  "scripts": {
    "test": "node --test tests-js/subannotation-profile.test.js",
    "prepublishOnly": "npm test"
  }
}
